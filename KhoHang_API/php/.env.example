APP_NAME="N3T KhoHang API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=single
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_DATABASE defaults to ../data/data.db (the FastAPI database). Override only for tests/copies.
# DB_DATABASE=
# KHOHANG_DATA_DIR=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Secrets (JWT_SECRET, SMTP_*, GEMINI_API_KEY) are read from KhoHang_API/.env,
# the same file the FastAPI backend used. Values set here take precedence.
# JWT_SECRET must be set: the PHP backend refuses to issue/accept tokens without it.

# Realtime WebSocket server (php artisan rt:serve)
RT_WS_PORT=8001
RT_INTERNAL_PORT=8002
